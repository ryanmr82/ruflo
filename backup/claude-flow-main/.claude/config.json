{
  "version": "1.0",
  "sparc": {
    "enabled": true,
    "modes": [
      "orchestrator",
      "coder",
      "researcher",
      "tdd",
      "architect",
      "reviewer",
      "debugger",
      "tester",
      "analyzer",
      "optimizer",
      "documenter",
      "designer",
      "innovator",
      "swarm-coordinator",
      "memory-manager",
      "batch-executor",
      "workflow-manager"
    ]
  },
  "swarm": {
    "enabled": true,
    "strategies": [
      "research",
      "development",
      "analysis",
      "testing",
      "optimization",
      "maintenance"
    ]
  },
  "output": {
    "defaultDirectory": "C:\\Claude-Flow\\output-files",
    "enforceDefault": true,
    "allowExternalWrites": true,
    "createBackups": true,
    "subdirectories": {
      "generated-code": [
        ".js",
        ".ts",
        ".py",
        ".java",
        ".cpp",
        ".c",
        ".h",
        ".go",
        ".rs",
        ".jsx",
        ".tsx"
      ],
      "reports": [
        ".md",
        ".txt",
        ".pdf",
        ".doc",
        ".docx"
      ],
      "data": [
        ".json",
        ".xml",
        ".csv",
        ".xlsx",
        ".xls",
        ".yaml",
        ".yml"
      ],
      "temp": [
        "*"
      ],
      "backups": [],
      "swarm-outputs": [],
      "hive-outputs": []
    }
  }
}
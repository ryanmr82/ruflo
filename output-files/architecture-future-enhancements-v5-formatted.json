    "flatDataFormat": {
      "title": "BANKALTEXPORT_V1 Flat Data Format",
      "description": "Pipe-delimited flat format for efficient parsing by the tray application",
      "diagram": [
        "┌─────────────────────────────────────────────────────────────────────────────────────┐",
        "│                     BANKALTEXPORT_V1 — FLAT DATA FORMAT                             │",
        "├─────────────────────────────────────────────────────────────────────────────────────┤",
        "│                                                                                     │",
        "│  Format: BANKALTEXPORT_V1|{timestamp}|{account}|{charCount}|{totalItems}           │",
        "│          [CHAR|{name}|{class}|{level}]                                              │",
        "│          [BAG|{bag}|{slot}|{name}|{count}|{quality}|{itemId}]...                   │",
        "│          [BANK|{bag}|{slot}|{name}|{count}|{quality}|{itemId}]...                  │",
        "│          [ENDCHAR]                                                                  │",
        "│          ... repeat for each character                                             │",
        "│                                                                                     │",
        "│  Example:                                                                           │",
        "│  ─────────────────────────────────────────────────────────────────────────────────  │",
        "│  BANKALTEXPORT_V1|1738857045|STORMBANK|2|4500                                       │",
        "│  CHAR|Bankalt|Mage|35                                                               │",
        "│  BAG|0|1|Greater Fire Protection Potion|20|1|13457                                  │",
        "│  BAG|1|3|Flask of the Titans|5|3|13510                                              │",
        "│  BANK|-1|1|Arcanite Bar|40|3|12360                                                  │",
        "│  BANK|5|2|Black Lotus|15|3|13468                                                    │",
        "│  ENDCHAR                                                                            │",
        "│  CHAR|Stashmaster|Rogue|5                                                           │",
        "│  BAG|0|1|Linen Cloth|200|1|2589                                                     │",
        "│  ENDCHAR                                                                            │",
        "│                                                                                     │",
        "└─────────────────────────────────────────────────────────────────────────────────────┘"
      ]
    },
    "wowApiReference": {
      "title": "WoW 1.12.1 API Reference — Bag & Bank Access",
      "description": "Key Lua API functions used for scanning character inventory",
      "diagram": [
        "┌─────────────────────────────────────────────────────────────────────────────────────┐",
        "│                      WOW 1.12.1 LUA API — BAG & BANK FUNCTIONS                      │",
        "├─────────────────────────────────────────────────────────────────────────────────────┤",
        "│                                                                                     │",
        "│  BAG IDS:                                                                           │",
        "│  ────────                                                                           │",
        "│   0      = Backpack (16 slots, always available)                                    │",
        "│   1-4    = Equipped bags (varying size based on bag item)                          │",
        "│  -1      = Main bank (24 slots, only at banker)                                     │",
        "│   5-11   = Bank bags (only at banker)                                               │",
        "│                                                                                     │",
        "│  KEY FUNCTIONS:                                                                     │",
        "│  ──────────────                                                                     │",
        "│  GetContainerNumSlots(bagId)                                                        │",
        "│    Returns: numSlots (number of slots in bag, 0 if not available)                  │",
        "│                                                                                     │",
        "│  GetContainerItemInfo(bagId, slot)                                                  │",
        "│    Returns: texture, count, locked, quality, readable                               │",
        "│    Note: Returns nil if slot empty                                                  │",
        "│                                                                                     │",
        "│  GetContainerItemLink(bagId, slot)                                                  │",
        "│    Returns: itemLink (contains itemId, name, enchants)                              │",
        "│    Example: |cff0070dd|Hitem:13510:0:0:0|h[Flask of the Titans]|h|r               │",
        "│                                                                                     │",
        "│  KEY EVENTS:                                                                        │",
        "│  ───────────                                                                        │",
        "│  BANKFRAME_OPENED  — Fired when player opens bank at banker NPC                    │",
        "│  BANKFRAME_CLOSED  — Fired when bank window closes                                  │",
        "│  BAG_UPDATE        — Fired when any bag contents change                             │",
        "│                                                                                     │",
        "└─────────────────────────────────────────────────────────────────────────────────────┘"
      ]
    },
    "apiEndpoints": {
      "title": "Server API Endpoints",
      "description": "Deno Fresh API endpoints for storing and retrieving data",
      "diagram": [
        "┌─────────────────────────────────────────────────────────────────────────────────────┐",
        "│                           SERVER API ENDPOINTS                                      │",
        "├─────────────────────────────────────────────────────────────────────────────────────┤",
        "│                                                                                     │",
        "│  EXISTING (Already Built):                                                          │",
        "│  ─────────────────────────                                                          │",
        "│  PUT  /api/consumes/prices                                                          │",
        "│       Body: { prices: [{item, price, timestamp}...], source: \"ingame\" }           │",
        "│       → Stores AH prices in Deno KV                                                 │",
        "│                                                                                     │",
        "│  PUT  /api/guild-bank/inventory                                                     │",
        "│       Body: { tabs: [{items}...], scanTime, totalItems }                           │",
        "│       → Stores guild vault contents in Deno KV                                      │",
        "│                                                                                     │",
        "│  GET  /api/guild-bank/inventory                                                     │",
        "│       → Returns current guild vault contents                                        │",
        "│                                                                                     │",
        "│  NEW (To Be Built):                                                                 │",
        "│  ─────────────────                                                                  │",
        "│  PUT  /api/bank-alts/inventory                                                      │",
        "│       Body: { account, characters: [{name, class, level, bags, bank}...] }         │",
        "│       → Stores bank alt inventory per account                                       │",
        "│                                                                                     │",
        "│  GET  /api/bank-alts/inventory                                                      │",
        "│       → Returns all bank alt inventories (all accounts combined)                   │",
        "│                                                                                     │",
        "│  GET  /api/bank-alts/inventory?account=STORMBANK                                    │",
        "│       → Returns specific account's bank alt inventory                               │",
        "│                                                                                     │",
        "│  GET  /api/guild-storage/combined                                                   │",
        "│       → Returns merged view: guild vault + all bank alts                            │",
        "│                                                                                     │",
        "└─────────────────────────────────────────────────────────────────────────────────────┘"
      ]
    }
  },


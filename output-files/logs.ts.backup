import { Handlers } from "$fresh/server.ts";

interface LogSubmission {
  raidType: string;
  raidName: string;
  bossKilled: string | null;
  startTime: string;
  endTime: string;
  lineCount: number;
  content: string;
}

interface PlayerStats {
  name: string;
  deaths: number;
  totalConsumables: number;
  food: Record<string, number>;
  potions: Record<string, number>;
  elixirs: Record<string, number>;
  flasks: Record<string, number>;
  jujus: Record<string, number>;
  scrolls: Record<string, number>;
  weaponEnhancements: Record<string, number>;
  worldBuffs: Record<string, number>;
  misc: Record<string, number>;
  dispels: Record<string, number>;
  protective: Record<string, number>;
  cc: {
    total: number;
    interrupts: Record<string, number>;  // spell interrupted -> count
    stuns: Record<string, number>;       // stun ability -> count
    polymorphs: Record<string, number>;  // poly target -> count
    fears: Record<string, number>;       // fear ability -> count
    roots: Record<string, number>;       // root ability -> count
    kicks: Record<string, number>;       // kick/pummel -> count
    other: Record<string, number>;       // other CC -> count
    byTarget: Record<string, number>;    // target name -> count
  };
}

// === LOOT TRACKING ===
interface LootDrop {
  timestamp: string;
  player: string;
  itemId: number;
  itemName: string;
  quality: string;
}

// Quality color codes from WoW
const QUALITY_COLORS: Record<string, string> = {
  'ff9d9d9d': 'poor',
  'ffffffff': 'common',
  'ff1eff00': 'uncommon',
  'ff0070dd': 'rare',
  'ffa335ee': 'epic',
  'ffff8000': 'legendary',
};

interface StoredLog {
  id: string;
  raidType: string;
  raidName: string;
  bossKilled: string | null;
  startTime: string;
  endTime: string;
  lineCount: number;
  uploadedAt: string;
  fileSize: number;
  playerStats: PlayerStats[];
  loot: LootDrop[];
  summary: {
    totalPlayers: number;
    totalDeaths: number;
    totalConsumables: number;
    totalDispels: number;
    mostDeaths: { player: string; count: number };
    mostConsumables: { player: string; count: number };
    mostDispels: { player: string; count: number };
    totalCC: number;
    mostCC: { player: string; count: number };
    totalLootDrops: number;
    epicDrops: number;
  };
}


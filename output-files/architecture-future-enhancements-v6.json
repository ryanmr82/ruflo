    "flatDataFormat": {
      "title": "BANKALTEXPORT_V1 Flat Data Format",
      "description": "Pipe-delimited flat format for efficient parsing by the tray application",
      "diagram": [
        "┌─────────────────────────────────────────────────────────────────────────────────────┐",
        "│                     BANKALTEXPORT_V1 — FLAT DATA FORMAT                             │",
        "├─────────────────────────────────────────────────────────────────────────────────────┤",
        "│                                                                                     │",
        "│  Header:  BANKALTEXPORT_V1|{timestamp}|{account}|{charCount}|{totalItems}          │",
        "│  Char:    CHAR|{name}|{class}|{level}                                              │",
        "│  Bag:     BAG|{bagId}|{slot}|{itemName}|{count}|{quality}|{itemId}                 │",
        "│  Bank:    BANK|{bagId}|{slot}|{itemName}|{count}|{quality}|{itemId}                │",
        "│  End:     ENDCHAR                                                                   │",
        "│                                                                                     │",
        "│  Example Output:                                                                    │",
        "│  ─────────────────────────────────────────────────────────────────────────────────  │",
        "│  BANKALTEXPORT_V1|1738857045|STORMBANK|2|4500                                       │",
        "│  CHAR|Bankalt|Mage|35                                                               │",
        "│  BAG|0|1|Greater Fire Protection Potion|20|1|13457                                  │",
        "│  BAG|1|3|Flask of the Titans|5|3|13510                                              │",
        "│  BANK|-1|1|Arcanite Bar|40|3|12360                                                  │",
        "│  ENDCHAR                                                                            │",
        "│  CHAR|Stashmaster|Rogue|5                                                           │",
        "│  BAG|0|1|Linen Cloth|200|1|2589                                                     │",
        "│  ENDCHAR                                                                            │",
        "│                                                                                     │",
        "└─────────────────────────────────────────────────────────────────────────────────────┘"
      ]
    },
    "apiEndpoints": {
      "title": "Server API Endpoints",
      "description": "Deno Fresh API endpoints for storing and retrieving inventory data",
      "diagram": [
        "┌─────────────────────────────────────────────────────────────────────────────────────┐",
        "│                           SERVER API ENDPOINTS                                      │",
        "├─────────────────────────────────────────────────────────────────────────────────────┤",
        "│                                                                                     │",
        "│  EXISTING:                                                                          │",
        "│  PUT  /api/consumes/prices         → Store AH prices                               │",
        "│  PUT  /api/guild-bank/inventory    → Store guild vault contents                    │",
        "│  GET  /api/guild-bank/inventory    → Retrieve guild vault contents                 │",
        "│                                                                                     │",
        "│  NEW (To Build):                                                                    │",
        "│  PUT  /api/bank-alts/inventory     → Store bank alt inventory (per account)        │",
        "│  GET  /api/bank-alts/inventory     → Retrieve all bank alt inventories             │",
        "│  GET  /api/bank-alts/inventory?account=X  → Filter by account                      │",
        "│  GET  /api/guild-storage/combined  → Merged vault + bank alts view                 │",
        "│                                                                                     │",
        "└─────────────────────────────────────────────────────────────────────────────────────┘"
      ]
    }
  },


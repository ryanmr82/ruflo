  "dataFlowDiagrams": {
    "bankAltDataHierarchy": {
      "title": "Bank Alt Data Hierarchy",
      "description": "How bank alt character inventory data is organized across accounts and characters",
      "diagram": [
        "┌─────────────────────────────────────────────────────────────────────────────────────┐",
        "│                        BANK ALT DATA HIERARCHY                                      │",
        "├─────────────────────────────────────────────────────────────────────────────────────┤",
        "│                                                                                     │",
        "│   Account (e.g., STORMBANK)                                                         │",
        "│   │                                                                                 │",
        "│   ├── Character: Bankalt (Level 35 Mage)                                           │",
        "│   │   ├── Bags [Always Accessible]: 80-88 slots                                    │",
        "│   │   └── Personal Bank [At Banker]: 122-150 slots                                 │",
        "│   │                                                                                 │",
        "│   ├── Character: Bankalt2 ... same structure                                       │",
        "│   └── Character: Stashmaster ... same structure                                    │",
        "│                                                                                     │",
        "│   WoW Bag IDs:                                                                      │",
        "│   • 0 = Backpack (16 slots)                                                        │",
        "│   • 1-4 = Equipped bags                                                            │",
        "│   • -1 = Main bank (24 slots, only at banker)                                      │",
        "│   • 5-11 = Bank bags (only at banker)                                              │",
        "│                                                                                     │",
        "└─────────────────────────────────────────────────────────────────────────────────────┘"
      ]
    },
    "flatDataFormat": {
      "title": "BANKALTEXPORT_V1 Flat Data Format",
      "description": "Pipe-delimited flat format for efficient parsing by the tray application",
      "diagram": [
        "┌─────────────────────────────────────────────────────────────────────────────────────┐",
        "│                     BANKALTEXPORT_V1 — FLAT DATA FORMAT                             │",
        "├─────────────────────────────────────────────────────────────────────────────────────┤",
        "│                                                                                     │",
        "│  Header:  BANKALTEXPORT_V1|{timestamp}|{account}|{charCount}|{totalItems}          │",
        "│  Char:    CHAR|{name}|{class}|{level}                                              │",
        "│  Bag:     BAG|{bagId}|{slot}|{itemName}|{count}|{quality}|{itemId}                 │",
        "│  Bank:    BANK|{bagId}|{slot}|{itemName}|{count}|{quality}|{itemId}                │",
        "│  End:     ENDCHAR                                                                   │",
        "│                                                                                     │",
        "│  Example:                                                                           │",
        "│  BANKALTEXPORT_V1|1738857045|STORMBANK|2|4500                                       │",
        "│  CHAR|Bankalt|Mage|35                                                               │",
        "│  BAG|0|1|Greater Fire Protection Potion|20|1|13457                                  │",
        "│  BANK|-1|1|Arcanite Bar|40|3|12360                                                  │",
        "│  ENDCHAR                                                                            │",
        "│                                                                                     │",
        "└─────────────────────────────────────────────────────────────────────────────────────┘"
      ]
    },
    "apiEndpoints": {
      "title": "Server API Endpoints",
      "description": "Existing (DONE) and new (TODO) Deno Fresh API endpoints",
      "diagram": [
        "┌─────────────────────────────────────────────────────────────────────────────────────┐",
        "│                           SERVER API ENDPOINTS                                      │",
        "├─────────────────────────────────────────────────────────────────────────────────────┤",
        "│                                                                                     │",
        "│  [DONE] EXISTING ENDPOINTS:                                                         │",
        "│  ──────────────────────────                                                         │",
        "│  PUT  /api/consumes/prices         → Store AH prices (Deno KV)                     │",
        "│  PUT  /api/guild-bank/inventory    → Store guild vault (Deno KV)                   │",
        "│  GET  /api/guild-bank/inventory    → Retrieve guild vault                          │",
        "│                                                                                     │",
        "│  [TODO] NEW ENDPOINTS (Phase 3):                                                    │",
        "│  ─────────────────────────────                                                      │",
        "│  PUT  /api/bank-alts/inventory     → Store bank alt inventory (per account)        │",
        "│  GET  /api/bank-alts/inventory     → Retrieve all bank alt inventories             │",
        "│  GET  /api/bank-alts/inventory?account=X  → Filter by account                      │",
        "│  GET  /api/guild-storage/combined  → Merged vault + bank alts                      │",
        "│                                                                                     │",
        "└─────────────────────────────────────────────────────────────────────────────────────┘"
      ]
    }
  },

